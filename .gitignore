# Build output
harness/bin/

# Generated workloads (deterministic from configs/benchmark.toml; recreated on demand)
fixtures/

# Benchmark output: scratch runs stay local; only the final run is committed
results/*
!results/README.md
!results/final/

# Python
__pycache__/
*.pyc
.venv/

# Local tools and reference material
.freebuff/
mtl-ref/
*.log

# Validation evidence is committed on purpose
!docs/validation/**/*.log
